{
  "name": "void-server",
  "version": "0.4.0",
  "description": "A terminal framework runtime simulator with lightweight built-in execution.",
  "type": "module",
  "license": "MIT",
  "author": "Ring-wdr",
  "homepage": "https://github.com/Ring-wdr/void-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ring-wdr/void-server.git"
  },
  "bugs": {
    "url": "https://github.com/Ring-wdr/void-server/issues"
  },
  "bin": {
    "void-server": "bin/void-server.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/void-server.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts",
    "observe:nest": "node scripts/capture-nest-observation.mjs",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@types/node": "^25.6.0",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0"
  }
}
